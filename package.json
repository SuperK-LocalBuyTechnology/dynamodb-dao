{
    "name": "@superk-in/dynamodb-dao",
    "description": "Typed, minimal BaseDAO and BaseModel for DynamoDB on top of nova-odm, with an optional pluggable cache.",
    "version": "0.1.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SuperK-LocalBuyTechnology/dynamodb-dao.git"
    },
    "homepage": "https://github.com/SuperK-LocalBuyTechnology/dynamodb-dao#readme",
    "bugs": {
        "url": "https://github.com/SuperK-LocalBuyTechnology/dynamodb-dao/issues"
    },
    "author": "SuperK-LocalBuyTechnology",
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "dynamodb",
        "aws",
        "dao",
        "nova-odm",
        "orm",
        "serverless",
        "typescript"
    ],
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "npm run build && npm test",
        "clean": "rm -rf node_modules && rm -rf package-lock.json && npm install",
        "watch": "tsc -w",
        "test": "jest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,mts,cts,js,mjs,cjs,json}\"",
        "format:check": "prettier --check \"**/*.{ts,mts,cts,js,mjs,cjs,json}\"",
        "prepare": "husky",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "*.{ts,mts,cts,js,mjs,cjs}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.json": "prettier --write"
    },
    "peerDependencies": {
        "@aws-sdk/client-dynamodb": "^3.0.0",
        "@nova-odm/annotations": "^0.8.7",
        "@nova-odm/expressions": "^0.8.7",
        "@nova-odm/mapper": "^0.8.7",
        "@nova-odm/marshaller": "^0.8.7"
    },
    "dependencies": {
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "@aws-sdk/client-dynamodb": "^3.1096.0",
        "@commitlint/cli": "^21.0.0",
        "@commitlint/config-conventional": "^21.0.0",
        "@eslint/js": "^9.39.4",
        "@nova-odm/annotations": "^0.8.7",
        "@nova-odm/expressions": "^0.8.7",
        "@nova-odm/mapper": "^0.8.7",
        "@nova-odm/marshaller": "^0.8.7",
        "@types/jest": "^29.5.12",
        "@types/node": "22.5.4",
        "@types/uuid": "^9.0.7",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^17.0.4",
        "prettier": "^3.8.3",
        "ts-jest": "^29.2.5",
        "tsup": "^8.0.0",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.59.2"
    }
}
